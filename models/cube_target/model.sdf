<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cube_target">
    <static>true</static>
    <link name="marker_link">
      <collision name="cube_collision">
        <geometry><box><size>3 3 3</size></box></geometry>
      </collision>
      <visual name="cube_body">
        <geometry><box><size>3 3 3</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://cube_target/materials/textures/error.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
