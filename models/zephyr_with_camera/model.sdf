<?xml version="1.0"?>
<sdf version="1.9">
  <model name="zephyr_with_camera">
    <include>
      <uri>model://zephyr_with_ardupilot</uri>
    </include>
    <link name="nose_camera_link">
      <!-- Zephyr: -Y forward, +Z up. Camera: +X forward.
           x y z roll pitch yaw; positive pitch looks down. -->
      <pose relative_to="zephyr_with_ardupilot::zephyr::wing" degrees="true">0 -0.425 0.00 0 15 -90</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.0000053333</ixx><iyy>0.0000053333</iyy><izz>0.0000053333</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="camera_body">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <sensor name="camera" type="camera">
        <pose>0.025 0 0 0 0 0</pose>
        <topic>/zephyr/camera/image</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>

        <camera>
          <horizontal_fov>0.9966</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15000</far></clip>
        </camera>

        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>

    </link>
    <joint name="nose_camera_joint" type="fixed">
      <parent>zephyr_with_ardupilot::zephyr::wing</parent>
      <child>nose_camera_link</child>
    </joint>
  </model>
</sdf>
